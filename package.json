{
  "name": "frida-code",
  "displayName": "Frida Code",
  "description": "Asistente de código (estilo Claude Code) sobre Pi + Softtek DevEngine Gateway.",
  "version": "0.0.1",
  "publisher": "softtek",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "frida.openPanel", "title": "Frida: Abrir panel" },
      { "command": "frida.setKey", "title": "Frida: Actualizar API key (DevEngine)" }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
