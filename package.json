{
  "name": "frida-code",
  "displayName": "Frida Code",
  "description": "Asistente de código (estilo Claude Code) sobre Pi + Softtek DevEngine Gateway.",
  "version": "0.0.1",
  "publisher": "softtek",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "frida.openPanel", "title": "Frida: Abrir panel" },
      { "command": "frida.setKey", "title": "Frida: Actualizar API key (DevEngine)" },
      { "command": "frida.compact", "title": "Frida: Compactar contexto" },
      { "command": "frida.reload", "title": "Frida: Recargar extensiones y recursos" },
      { "command": "frida.abort", "title": "Frida: Detener respuesta" },
      { "command": "frida.newSession", "title": "Frida: Nueva sesión" },
      { "command": "frida.approvalMode", "title": "Frida: Cambiar modo de aprobación" }
    ]
  },
  "scripts": {
    "build": "node esbuild.js && vite build",
    "build:host": "node esbuild.js",
    "build:webview": "vite build",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
